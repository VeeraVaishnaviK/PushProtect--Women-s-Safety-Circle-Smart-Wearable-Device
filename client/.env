# Push Protect Frontend Environment Configuration
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_SOCKET_URL=http://localhost:3001

# Map & Location Provider:
# Push Protect uses zero-complexity open map engines (OpenStreetMap, Esri World Imagery Satellite, OpenTopoMap)
# Real live location is captured natively via device GPS sensor (navigator.geolocation).
# Zero API keys, zero credit cards, zero billing required.
# Optional override only (leave blank for standard open engine):
VITE_GOOGLE_MAPS_API_KEY=
